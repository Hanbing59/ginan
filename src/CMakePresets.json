{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vcpkg-base",
      "hidden": true,
      "description": "Base configure preset using vcpkg",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "VCPKG_MANIFEST_MODE": "ON",
        "VCPKG_MANIFEST_DIR": "${sourceDir}/.."
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "description": "Base configure preset using vcpkg for Linux x64",
      "inherits": "vcpkg-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/../vcpkg_installed/linux"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Release build using vcpkg for Linux x64",
      "binaryDir": "${sourceDir}/build/linux-Release",
      "inherits": ["linux-base"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_DOC": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Debug build using vcpkg for Linux x64",
      "binaryDir": "${sourceDir}/build/linux-Debug",
      "inherits": ["linux-base"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_DOC": "ON"
      }
    },
    {
      "name": "relwithdebinfo",
      "displayName": "RelWithDebInfo",
      "description": "Optimized build with debug symbols for profiling for Linux x64",
      "binaryDir": "${sourceDir}/build/linux-RelWithDebInfo",
      "inherits": ["linux-base"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "description": "Base configure preset using vcpkg for Windows x64",
      "inherits": "vcpkg-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/../vcpkg_installed/windows"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows Release",
      "description": "Release build using vcpkg for Windows x64",
      "binaryDir": "${sourceDir}/build/windows-Release",
      "inherits": ["windows-base"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXE_LINKER_FLAGS": "-static"
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows Debug",
      "description": "Debug build using vcpkg for Windows x64",
      "binaryDir": "${sourceDir}/build/windows-Debug",
      "inherits": ["windows-base"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXE_LINKER_FLAGS": "-static"
      }
    },
    {
      "name": "macos-base",
      "hidden": true,
      "description": "Base configure preset using vcpkg for MacOS",
      "inherits": "vcpkg-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "BLA_VENDOR": "Apple"
      }
    },
    {
      "name": "macos-arm64",
      "hidden": true,
      "description": "Base configure preset using vcpkg for MacOS ARM64",
      "inherits": "macos-base",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-osx",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchain/clang_mac_arm64.cmake",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/../vcpkg_installed/macos-arm64"
      }
    },
    {
      "name": "macos-arm64-release",
      "displayName": "MacOS ARM64 Release",
      "description": "Release build using vcpkg for MacOS ARM64",
      "binaryDir": "${sourceDir}/build/mac-arm64-Release",
      "inherits": ["macos-arm64"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "macos-arm64-debug",
      "displayName": "MacOS ARM64 Debug",
      "description": "Debug build using vcpkg for MacOS ARM64",
      "binaryDir": "${sourceDir}/build/mac-arm64-Debug",
      "inherits": ["macos-arm64"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "macos-x64",
      "hidden": true,
      "description": "Base configure preset using vcpkg for MacOS x64",
      "inherits": "macos-base",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-osx",
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchain/clang_mac_x64.cmake",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/../vcpkg_installed/macos-x64"
      }
    },
    {
      "name": "macos-x64-release",
      "displayName": "MacOS x64 Release",
      "description": "Release build using vcpkg for MacOS x64",
      "binaryDir": "${sourceDir}/build/mac-x64-Release",
      "inherits": ["macos-x64"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "macos-x64-debug",
      "displayName": "MacOS x64 Debug",
      "description": "Debug build using vcpkg for MacOS x64",
      "binaryDir": "${sourceDir}/build/mac-x64-Debug",
      "inherits": ["macos-x64"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "mingw-cross-base",
      "hidden": true,
      "description": "Base configuration preset for cross-compiling Windows builds using MinGW-w64 on Linux",
      "inherits": "vcpkg-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_C_COMPILER": "x86_64-w64-mingw32-gcc",
        "CMAKE_CXX_COMPILER": "x86_64-w64-mingw32-g++",
        "CMAKE_RC_COMPILER": "x86_64-w64-mingw32-windres",
        "CMAKE_FIND_ROOT_PATH_MODE_PROGRAM": "NEVER",
        "CMAKE_FIND_ROOT_PATH_MODE_LIBRARY": "ONLY",
        "CMAKE_FIND_ROOT_PATH_MODE_INCLUDE": "ONLY",
        "VCPKG_TARGET_TRIPLET": "x64-mingw-static",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchain/mingw64.cmake",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/../vcpkg_installed/mingw",
        "OPENSSL_ROOT_DIR": "${sourceDir}/../vcpkg_installed/mingw/x64-mingw-static",
        "ENABLE_MONGODB": "OFF"
      }
    },
    {
      "name": "windows-cross-release",
      "displayName": "Windows Cross-compile Release",
      "description": "Cross-compile Release build for Windows using MinGW-w64",
      "binaryDir": "${sourceDir}/build/windows-cross-Release",
      "inherits": ["mingw-cross-base"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-cross-debug",
      "displayName": "Windows Cross-compile Debug",
      "description": "Cross-compile Debug build for Windows using MinGW-w64",
      "binaryDir": "${sourceDir}/build/windows-cross-Debug",
      "inherits": ["mingw-cross-base"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "mingw-native-base",
      "hidden": true,
      "description": "Base configuration preset for native Windows builds using MinGW-w64",
      "inherits": "vcpkg-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "VCPKG_TARGET_TRIPLET": "x64-mingw-static",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchain/mingw64.cmake",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/../vcpkg_installed/mingw",
        "ENABLE_MONGODB": "OFF"
      }
    },
    {
      "name": "windows-mingw-release",
      "displayName": "Windows MinGW Native Release",
      "description": "Native Release build for Windows using MinGW-w64",
      "binaryDir": "${sourceDir}/build/windows-mingw-Release",
      "inherits": ["mingw-native-base"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-mingw-debug",
      "displayName": "Windows MinGW Native Debug",
      "description": "Native Debug build for Windows using MinGW-w64",
      "binaryDir": "${sourceDir}/build/windows-mingw-Debug",
      "inherits": ["mingw-native-base"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "displayName": "Release Build",
      "jobs": 12
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "displayName": "Debug Build",
      "jobs": 12
    },
    {
      "name": "relwithdebinfo",
      "configurePreset": "relwithdebinfo",
      "displayName": "RelWithDebInfo Build",
      "jobs": 12
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "displayName": "Windows Release Build",
      "jobs": 12
    },
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "displayName": "Windows Debug Build",
      "jobs": 12
    },
    {
      "name": "macos-arm64-release",
      "configurePreset": "macos-arm64-release",
      "displayName": "macOS ARM64 Release Build",
      "jobs": 12
    },
    {
      "name": "macos-arm64-debug",
      "configurePreset": "macos-arm64-debug",
      "displayName": "macOS ARM64 Debug Build",
      "jobs": 12
    },
    {
      "name": "macos-x64-release",
      "configurePreset": "macos-x64-release",
      "displayName": "macOS x64 Release Build",
      "jobs": 12
    },
    {
      "name": "macos-x64-debug",
      "configurePreset": "macos-x64-debug",
      "displayName": "macOS x64 Debug Build",
      "jobs": 12
    },
    {
      "name": "windows-cross-release",
      "configurePreset": "windows-cross-release",
      "displayName": "Windows Cross-compile Release Build",
      "jobs": 12
    },
    {
      "name": "windows-cross-debug",
      "configurePreset": "windows-cross-debug",
      "displayName": "Windows Cross-compile Debug Build",
      "jobs": 12
    },
    {
      "name": "windows-mingw-release",
      "configurePreset": "windows-mingw-release",
      "displayName": "Windows MinGW Native Release Build",
      "jobs": 12
    },
    {
      "name": "windows-mingw-debug",
      "configurePreset": "windows-mingw-debug",
      "displayName": "Windows MinGW Native Debug Build",
      "jobs": 12
    },
    {
      "name": "make_otl_blq",
      "configurePreset": "release",
      "displayName": "Build make_otl_blq (NetCDF ocean tide loading)",
      "jobs": 12,
      "targets": ["make_otl_blq"]
    },
    {
      "name": "interpolate_loading",
      "configurePreset": "release",
      "displayName": "Build interpolate_loading (NetCDF loading interpolation)",
      "jobs": 12,
      "targets": ["interpolate_loading"]
    },
    {
      "name": "netcdf-programs",
      "configurePreset": "release",
      "displayName": "Build all NetCDF programs",
      "jobs": 12,
      "targets": ["make_otl_blq", "interpolate_loading"]
    }
  ]
}
